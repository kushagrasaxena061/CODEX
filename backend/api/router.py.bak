import logging, os, shutil, zipfile, tempfile
from typing import Optional
from fastapi import APIRouter, Depends, UploadFile, File, HTTPException
from fastapi.responses import FileResponse
from pydantic import BaseModel
from sqlalchemy.orm import Session
from backend.database.connection import get_db, engine, Base
from backend.database.models import Conversation, Task
from backend.database.migrate import run_migration
from backend.agents.planner import generate_plan
from backend.agents.orchestrator import TaskOrchestrator
from backend.config.settings import settings
from backend.events.bus import event_bus
from backend.execution.cancel_manager import cancel_manager
from backend.repository.git_manager import GitManager
from backend.repository.scanner import get_repo_tree
from backend.repository.rag_manager import rag_db
from backend.execution.token_tracker import token_tracker
from backend.llm.ollama_client import generate_json
from backend.execution.context import current_session_id

logger = logging.getLogger(__name__)
run_migration()
Base.metadata.create_all(bind=engine)

# FINAL PRODUCTION FIX: Clean up orphaned working tasks on server boot
def cleanup_orphans():
    from backend.database.connection import SessionLocal
    db = SessionLocal()
    try:
        orphans = db.query(Task).filter(Task.status == "WORKING").all()
        for t in orphans:
            t.status = "ERROR"
            t.context_summary = "System unexpectedly shut down during execution. Task aborted."
        db.commit()
    finally:
        db.close()
cleanup_orphans()


