import { useState, useRef, useEffect } from 'react';

function App() {
  const [conversations, setConversations] = useState([]);
  const [activeConvId, setActiveConvId] = useState(null);

  // THE FIX: True Isolation. Every variable is now a dictionary keyed by the Project/Session ID
  const [prompts, setPrompts] = useState({});
  const [taskPrompts, setTaskPrompts] = useState({});
  const [chats, setChats] = useState({});
  const [statuses, setStatuses] = useState({});
  const [approvals, setApprovals] = useState({});
  const [tokens, setTokens] = useState({});
  const [allLogs, setAllLogs] = useState({});

  // Rename States
  const [editingConvId, setEditingConvId] = useState(null);
  const [editTitle, setEditTitle] = useState('');

  const [showGithubModal, setShowGithubModal] = useState(false);
  const [showMountModal, setShowMountModal] = useState(false);
  const [localMountPath, setLocalMountPath] = useState("");
  const [githubUrl, setGithubUrl] = useState('');
  const [githubToken, setGithubToken] = useState('');

  const fileInputRef = useRef(null);
  const chatEndRef = useRef(null);
  const terminalEndRef = useRef(null);

  // Derive current active values for the UI
  const prompt = prompts[activeConvId] || '';
  const currentTaskPrompt = taskPrompts[activeConvId] || '';
  const chat = chats[activeConvId] || [];
  const status = statuses[activeConvId] || 'IDLE';
  const needsApproval = approvals[activeConvId] || false;
  const tokensUsed = tokens[activeConvId] || 0;
  const logs = allLogs[activeConvId] || [];
  const activeConv = conversations.find(c => c.id === activeConvId);

  useEffect(() => { chatEndRef.current?.scrollIntoView({ behavior: "smooth" }); }, [chat, status]);
  useEffect(() => { terminalEndRef.current?.scrollIntoView({ behavior: "smooth" }); }, [logs]);

  const loadConversations = async () => {
    try {
      const res = await fetch('http://localhost:8000/api/conversations');
      const data = await res.json();
      setConversations(data);
      if (data.length > 0 && !activeConvId) {
        selectConversation(data[0].id);
      }
    } catch (e) {}
  };

  useEffect(() => { loadConversations(); }, []);

  const selectConversation = async (id) => {
    setActiveConvId(id);
    try {
      const res = await fetch(`http://localhost:8000/api/conversations/${id}/tasks`);
      const data = await res.json();
      const messages = [];
      let isAwaiting = false;
      let isWorking = false;
      let lastPrompt = '';

      data.forEach(t => {
        messages.push({ role: 'user', content: t.prompt });
        if (t.summary) messages.push({ role: 'system', content: t.summary });
        if (t.status === 'PENDING_APPROVAL') { isAwaiting = true; lastPrompt = t.prompt; }
        if (t.status === 'WORKING') isWorking = true;
      });

      setChats(p => ({...p, [id]: messages}));
      setApprovals(p => ({...p, [id]: isAwaiting}));
      setTaskPrompts(p => ({...p, [id]: lastPrompt}));
      
      setStatuses(prev => {
         const current = prev[id] || 'IDLE';
         if (current === 'WORKING...') return prev; // Do not interrupt active tasks
         if (isAwaiting) return { ...prev, [id]: 'AWAITING REVIEW' };
         if (isWorking) return { ...prev, [id]: 'WORKING...' };
         return { ...prev, [id]: 'IDLE' };
      });
    } catch (e) {}
  };

  const createNewSession = async () => {
    try {
      const res = await fetch('http://localhost:8000/api/conversations', { method: 'POST' });
      const newConv = await res.json();
      setConversations(prev => [newConv, ...prev]);
      selectConversation(newConv.id);
    } catch (e) {}
  };

  const startEditing = (e, conv) => {
    e.stopPropagation();
    setEditingConvId(conv.id);
    setEditTitle(conv.title);
  };

  const saveRename = async (id) => {
    if (!editTitle.trim()) {
      setEditingConvId(null);
      return;
    }
    try {
      await fetch(`http://localhost:8000/api/conversations/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title: editTitle })
      });
      setConversations(prev => prev.map(c => c.id === id ? { ...c, title: editTitle } : c));
    } catch (e) {}
    setEditingConvId(null);
  };

  const deleteSession = async (e, id) => {
    e.stopPropagation();
    try {
      await fetch(`http://localhost:8000/api/conversations/${id}`, { method: 'DELETE' });
      const remaining = conversations.filter(c => c.id !== id);
      setConversations(remaining);
      if (activeConvId === id && remaining.length > 0) {
        selectConversation(remaining[0].id);
      }
    } catch (e) {}
  };

  // THE FIX: True Concurrency Polling. It pulls live logs for ALL working tabs in the background.
  useEffect(() => {
    const interval = setInterval(async () => {
      const activeIds = Object.keys(statuses).filter(id => statuses[id] === 'WORKING...' || statuses[id] === 'ANALYZING ARCHITECTURE...');
      for (const idStr of activeIds) {
        const id = parseInt(idStr);
        try {
          const res = await fetch(`http://localhost:8000/api/logs/live?conversation_id=${id}`);
          const data = await res.json();
          if (data.logs) setAllLogs(p => ({...p, [id]: data.logs}));

          const tokenRes = await fetch(`http://localhost:8000/api/telemetry?conversation_id=${id}`);
          const tokenData = await tokenRes.json();
          setTokens(p => ({...p, [id]: tokenData.tokens}));
        } catch (err) {}
      }
    }, 500);
    return () => clearInterval(interval);
  }, [statuses]);

  const handleUpload = async (e) => {
    const file = e.target.files[0];
    const targetId = activeConvId;
    if (!file || !targetId) return;
    
    setStatuses(p => ({...p, [targetId]: 'ANALYZING ARCHITECTURE...'}));
    const formData = new FormData();
    formData.append('file', file);
    try {
      await fetch(`http://localhost:8000/api/workspace/upload?conversation_id=${targetId}`, { method: 'POST', body: formData });
      setChats(p => ({...p, [targetId]: [...(p[targetId]||[]), { role: 'system', content: 'Workspace uploaded and indexed for this project.' }]}));
    } catch (error) {}
    setStatuses(p => ({...p, [targetId]: 'IDLE'}));
  };

  const handleDownload = () => {
    if (activeConvId) window.open(`http://localhost:8000/api/workspace/download?conversation_id=${activeConvId}`, '_blank');
  };

  const connectGithub = async () => {
    if (!activeConvId) return;
    try {
      await fetch('http://localhost:8000/api/github/connect', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ conversation_id: activeConvId, repo_url: githubUrl, token: githubToken })
      });
      setShowGithubModal(false);
      setConversations(prev => prev.map(c => c.id === activeConvId ? { ...c, github_connected: true } : c));
      const username = githubUrl.split('/')[3] || 'GitHub';
      setChats(p => ({...p, [activeConvId]: [...(p[activeConvId]||[]), { role: 'system', content: `Connected to ${username} for this project.` }]}));
    } catch (e) {}
  };

  const handleDecision = async (decision) => {
    const targetId = activeConvId;
    if (!targetId) return;
    
    setStatuses(p => ({...p, [targetId]: 'WORKING...'}));
    setApprovals(p => ({...p, [targetId]: false}));
    try {
      if (decision === 'approve') {
        await fetch('http://localhost:8000/api/checkpoint/approve', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ conversation_id: targetId, commit_message: taskPrompts[targetId] || "Human approved update" })
        });
        setChats(p => ({...p, [targetId]: [...(p[targetId]||[]), { role: 'system', content: `Approved. Checkpoint saved & synced.` }]}));
      } else {
        await fetch('http://localhost:8000/api/checkpoint/reject', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ conversation_id: targetId })
        });
        setChats(p => ({...p, [targetId]: [...(p[targetId]||[]), { role: 'system', content: `Rejected. Workspace rolled back.` }]}));
      }
    } catch (e) {}
    setStatuses(p => ({...p, [targetId]: 'IDLE'}));
  };

  const sendPrompt = async (forcedPrompt = null) => {
    const targetId = activeConvId;
    const textToSend = forcedPrompt || prompt;
    if (!textToSend.trim() || !targetId) return;
    
    setTaskPrompts(p => ({...p, [targetId]: textToSend}));
    if (!forcedPrompt) setPrompts(p => ({...p, [targetId]: ''}));
    setChats(p => ({...p, [targetId]: [...(p[targetId]||[]), { role: 'user', content: textToSend }]}));
    setStatuses(p => ({...p, [targetId]: 'WORKING...'}));

    try {
      const res = await fetch('http://localhost:8000/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ conversation_id: targetId, prompt: textToSend })
      });
      const data = await res.json();

      // Final telemetry fetch for this specific chat
      try {
          const lRes = await fetch(`http://localhost:8000/api/logs/live?conversation_id=${targetId}`);
          const lData = await lRes.json();
          if (lData.logs) setAllLogs(p => ({...p, [targetId]: lData.logs}));
          const tRes = await fetch(`http://localhost:8000/api/telemetry?conversation_id=${targetId}`);
          const tData = await tRes.json();
          setTokens(p => ({...p, [targetId]: tData.tokens}));
      } catch(e){}

      if (data.status === 'duplicate') {
        setChats(p => ({...p, [targetId]: [...(p[targetId]||[]), { role: 'system', content: `Feature already exists: ${data.message}` }]}));
        setStatuses(p => ({...p, [targetId]: 'IDLE'}));
      } else if (data.status === 'requires_approval') {
        setChats(p => ({...p, [targetId]: [...(p[targetId]||[]), { role: 'system', content: data.message }]}));
        setApprovals(p => ({...p, [targetId]: true}));
        setStatuses(p => ({...p, [targetId]: 'AWAITING REVIEW'}));
      } else {
        setChats(p => ({...p, [targetId]: [...(p[targetId]||[]), { role: 'system', content: data.message }]}));
        setStatuses(p => ({...p, [targetId]: 'IDLE'}));
      }
    } catch (e) {
      setStatuses(p => ({...p, [targetId]: 'IDLE'}));
    }
  };

  const getTagColor = (tag, level) => {
    if (level === 'ERROR') return 'bg-rose-500/20 text-rose-300 border-rose-500/30';
    if (level === 'WARN') return 'bg-amber-500/20 text-amber-300 border-amber-500/30';
    if (level === 'SUCCESS') return 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30';
    if (tag === 'CODE_AGENT') return 'bg-blue-500/20 text-blue-300 border-blue-500/30';
    if (tag === 'PLANNER' || tag === 'ARCHITECT') return 'bg-purple-500/20 text-purple-300 border-purple-500/30';
    if (tag === 'VISION_AGENT') return 'bg-fuchsia-500/20 text-fuchsia-300 border-fuchsia-500/30';
    return 'bg-zinc-800/80 text-zinc-300 border-zinc-700/50';
  };

  return (
    <div className="flex h-screen bg-[#030303] text-[#ececf1] font-sans antialiased overflow-hidden selection:bg-indigo-500/30 relative">
      
      {showGithubModal && (
        <div className="absolute inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md">
          <div className="bg-[#0c0c0e] border border-white/10 rounded-2xl p-7 w-[420px] shadow-2xl flex flex-col gap-4">
            <h2 className="text-base font-bold text-white flex items-center gap-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
              Link GitHub for {activeConv?.title}
            </h2>
            <input type="text" placeholder="Repo URL (https://github.com/user/repo.git)" value={githubUrl} onChange={e => setGithubUrl(e.target.value)} className="w-full bg-[#18181b] p-3 rounded-xl border border-white/10 text-sm outline-none focus:border-indigo-500 transition-all" />
            <input type="password" placeholder="Personal Access Token (PAT)" value={githubToken} onChange={e => setGithubToken(e.target.value)} className="w-full bg-[#18181b] p-3 rounded-xl border border-white/10 text-sm outline-none focus:border-indigo-500 transition-all" />
            <div className="flex justify-end gap-3 mt-4">
              <button onClick={() => setShowGithubModal(false)} className="px-5 py-2.5 rounded-xl text-xs font-semibold text-zinc-400 hover:text-white transition-colors">Cancel</button>
              <button onClick={connectGithub} className="px-5 py-2.5 rounded-xl text-xs font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 hover:bg-indigo-500/30 transition-all">Secure Connect</button>
            </div>
          </div>
        </div>
      )}

      {/* Project Sessions Sidebar */}
      <div className="w-64 bg-[#09090b] border-r border-white/5 flex flex-col shrink-0 z-20 shadow-xl">
        <div className="h-16 px-5 border-b border-white/5 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-7 h-7 rounded-lg bg-gradient-to-br from-zinc-700 to-zinc-900 border border-white/10 flex items-center justify-center shadow-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#e4e4e7" strokeWidth="2.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            </div>
            <span className="font-bold tracking-widest text-xs text-white">DARWIN</span>
          </div>
          <button onClick={createNewSession} className="p-1.5 rounded-lg text-zinc-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/5 transition-all shadow-sm" title="New Session">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
        </div>

        <div className="flex-1 overflow-y-auto p-4 flex flex-col gap-2">
          <span className="text-[10px] font-bold text-zinc-500 px-2 py-1 uppercase tracking-widest mb-1">Projects / Sessions</span>
          {conversations.map(conv => (
            <div
              key={conv.id}
              onClick={() => { if (editingConvId !== conv.id) selectConversation(conv.id); }}
              className={`group relative flex items-center justify-between px-3 py-3 rounded-xl text-sm cursor-pointer transition-all duration-300 ${
                conv.id === activeConvId
                  ? 'bg-indigo-500/10 border border-indigo-500/20 text-indigo-100 shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]'
                  : 'text-zinc-400 hover:bg-white/[0.04] hover:text-zinc-200 border border-transparent'
              }`}
            >
              {editingConvId === conv.id ? (
                <input 
                  autoFocus 
                  value={editTitle} 
                  onChange={e => setEditTitle(e.target.value)} 
                  onBlur={() => saveRename(conv.id)} 
                  onKeyDown={e => { if(e.key === 'Enter') saveRename(conv.id); if(e.key === 'Escape') setEditingConvId(null); }} 
                  className="bg-black/40 text-white text-xs px-2 py-1 rounded outline-none border border-indigo-500/50 w-full shadow-inner"
                />
              ) : (
                <>
                  <div className="flex items-center gap-3 truncate">
                    <span className={`w-2 h-2 rounded-full shadow-sm ${conv.github_connected ? 'bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]' : 'bg-zinc-600'}`}></span>
                    <span className="truncate font-medium">{conv.title}</span>
                  </div>
                  <div className="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                    <button onClick={(e) => startEditing(e, conv)} className="p-1.5 text-zinc-500 hover:text-indigo-400 rounded-md hover:bg-white/5">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                    </button>
                    {conversations.length > 1 && (
                      <button onClick={(e) => deleteSession(e, conv.id)} className="p-1.5 text-zinc-500 hover:text-rose-400 rounded-md hover:bg-white/5">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      </button>
                    )}
                  </div>
                </>
              )}
            </div>
          ))}
        </div>
      </div>

      {/* Main Canvas */}
      <div className="flex-1 flex flex-col relative z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-zinc-900/20 via-[#0c0c0e] to-[#050505]">
        <header className="px-6 py-4 flex justify-between items-center z-20 absolute top-0 w-full border-b border-white/5 bg-[#0c0c0e]/60 backdrop-blur-xl shadow-sm">
          <div className="flex items-center gap-4">
            <span className="font-semibold text-xs text-white bg-white/10 px-3 py-1.5 rounded-full border border-white/5">{activeConv?.title}</span>
            <div className="flex items-center gap-2 bg-amber-500/10 border border-amber-500/20 px-3 py-1.5 rounded-full shadow-sm">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" strokeWidth="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              <span className="text-[10px] font-bold text-amber-400 tracking-widest">{tokensUsed.toLocaleString()} TOKENS</span>
            </div>
          </div>

          <div className="flex gap-3">
            {activeConv?.github_connected ? (
              <div className="px-4 py-2 rounded-lg text-xs font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 flex items-center gap-2 shadow-[0_0_10px_rgba(16,185,129,0.1)] cursor-default">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                GitHub Connected
              </div>
            ) : (
              <button onClick={() => setShowGithubModal(true)} className="px-4 py-2 rounded-lg text-xs font-semibold text-zinc-300 bg-white/5 hover:bg-white/10 border border-white/10 transition-all flex items-center gap-2 shadow-sm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                Connect GitHub
              </button>
            )}
            <input type="file" ref={fileInputRef} onChange={handleUpload} accept=".zip" className="hidden" />
            <button onClick={() => fileInputRef.current.click()} className="px-4 py-2 rounded-lg text-xs font-semibold text-zinc-300 bg-white/5 hover:bg-white/10 border border-white/10 transition-all flex items-center gap-2 shadow-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Upload Workspace
            </button>
          </div>
        </header>

        <div className="flex-1 overflow-y-auto px-6 md:px-16 pt-28 pb-52 flex flex-col gap-6">
          {chat.length === 0 ? (
            <div className="flex-1 flex flex-col items-center justify-center animate-fade-in-up mt-10">
               <div className="w-24 h-24 mb-6 relative">
                  <div className="absolute inset-0 bg-indigo-500/20 blur-xl rounded-full animate-pulse"></div>
                  <div className="relative w-full h-full bg-gradient-to-br from-indigo-500 to-fuchsia-600 rounded-3xl flex items-center justify-center shadow-2xl border border-white/20">
                     <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                  </div>
               </div>
               <h1 className="text-3xl font-light text-white mb-2 tracking-wide">Welcome to <span className="font-bold">DARWIN</span></h1>
               <p className="text-zinc-400 mb-10 max-w-sm text-center text-sm leading-relaxed">Your autonomous AI software engineer. Select a prompt below or start typing to begin building.</p>
               
               <div className="grid grid-cols-2 gap-4 w-full max-w-2xl">
                  <div onClick={() => sendPrompt("Build a sleek dark mode dashboard with Tailwind CSS")} className="p-5 rounded-2xl bg-white/[0.02] border border-white/5 hover:bg-white/[0.05] hover:border-white/10 transition-all cursor-pointer group">
                     <h3 className="text-zinc-200 font-semibold text-sm mb-1 group-hover:text-indigo-300">Frontend UI</h3>
                     <p className="text-zinc-500 text-xs leading-relaxed">Build a sleek dark mode dashboard with Tailwind CSS</p>
                  </div>
                  <div onClick={() => sendPrompt("Create a REST API with FastAPI and SQLite")} className="p-5 rounded-2xl bg-white/[0.02] border border-white/5 hover:bg-white/[0.05] hover:border-white/10 transition-all cursor-pointer group">
                     <h3 className="text-zinc-200 font-semibold text-sm mb-1 group-hover:text-indigo-300">Backend API</h3>
                     <p className="text-zinc-500 text-xs leading-relaxed">Create a REST API with FastAPI and SQLite</p>
                  </div>
               </div>
            </div>
          ) : (
            chat.map((msg, i) => (
              <div key={i} className={`flex w-full ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                {msg.role === 'system' && (
                  <div className="w-8 h-8 rounded-full bg-gradient-to-br from-zinc-700 to-zinc-900 border border-zinc-600 flex items-center justify-center mr-4 mt-1 shrink-0 shadow-md">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#e4e4e7" strokeWidth="2.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                  </div>
                )}
                <div className={`relative max-w-[80%] text-[14.5px] leading-relaxed p-5 shadow-lg ${
                  msg.role === 'user'
                    ? 'bg-gradient-to-b from-zinc-800 to-zinc-900 text-zinc-100 rounded-2xl rounded-tr-sm border border-zinc-700'
                    : 'bg-[#121216]/80 backdrop-blur-sm text-zinc-300 rounded-2xl rounded-tl-sm border border-white/5'
                }`}>
                  {msg.content}
                </div>
              </div>
            ))
          )}

          {(status === 'WORKING...' || status === 'ANALYZING ARCHITECTURE...') && (
            <div className="flex w-full justify-start animate-fade-in-up">
              <div className="w-8 h-8 rounded-full bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center mr-4 mt-1 shrink-0 relative">
                 <div className="absolute inset-0 rounded-full border border-indigo-400/30 animate-ping"></div>
                 <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#818cf8" strokeWidth="2.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/></svg>
              </div>
              <div className="relative max-w-[80%] text-[14px] leading-relaxed p-5 bg-transparent text-indigo-300/90 rounded-2xl flex items-center gap-3">
                <span className="font-semibold tracking-wide">Darwin is executing instructions...</span>
              </div>
            </div>
          )}
          <div ref={chatEndRef} />
        </div>

        <div className="absolute bottom-8 left-0 w-full flex justify-center px-6 z-30">
          <div className="w-full max-w-3xl flex flex-col gap-4">
            {needsApproval && (
              <div className="flex gap-3 justify-center bg-black/40 backdrop-blur-xl p-3 rounded-2xl border border-white/10 shadow-2xl">
                <button onClick={() => handleDecision('reject')} className="px-5 py-2.5 rounded-xl bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 border border-rose-500/30 text-xs font-bold transition-all shadow-sm">
                  Reject & Rollback
                </button>
                <button onClick={handleDownload} className="px-5 py-2.5 rounded-xl bg-blue-500/10 text-blue-400 hover:bg-blue-500/20 border border-blue-500/30 text-xs font-bold transition-all shadow-sm">
                  Export Local Test
                </button>
                <button onClick={() => handleDecision('approve')} className="px-5 py-2.5 rounded-xl bg-emerald-500/20 text-emerald-400 hover:bg-emerald-500/30 border border-emerald-500/40 text-xs font-bold transition-all shadow-[0_0_15px_rgba(16,185,129,0.15)]">
                  Approve & Commit
                </button>
              </div>
            )}

            <div className="relative flex items-end bg-[#121215]/90 backdrop-blur-2xl border border-white/10 rounded-2xl shadow-2xl focus-within:border-indigo-500/50 focus-within:ring-1 focus-within:ring-indigo-500/30 transition-all duration-300">
              <textarea
                value={prompt}
                onChange={e => setPrompts(p => ({...p, [activeConvId]: e.target.value}))}
                onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendPrompt(); } }}
                className="flex-1 bg-transparent p-5 text-[15px] text-zinc-100 outline-none resize-none placeholder-zinc-500"
                placeholder="Instruct Darwin on this project..."
                disabled={status !== 'IDLE' && !needsApproval}
                rows={1}
              />
              <div className="p-3">
                <button onClick={() => sendPrompt()} disabled={status !== 'IDLE' || !prompt.trim()} className="p-3 rounded-xl bg-white text-black hover:bg-zinc-200 disabled:opacity-20 transition-all">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Terminal Telemetry */}
      <div className="w-[440px] bg-[#000000] border-l border-white/5 flex flex-col z-20 shrink-0 shadow-2xl">
        <div className="h-16 px-5 border-b border-white/5 flex items-center justify-between bg-[#030303]">
          <span className="text-[11px] font-bold text-zinc-500 uppercase tracking-widest flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
            Live Execution Console
          </span>
          <div className="flex items-center gap-2 bg-white/5 px-3 py-1.5 rounded-lg border border-white/5">
            <div className={`w-1.5 h-1.5 rounded-full ${status === 'IDLE' ? 'bg-zinc-600' : 'bg-emerald-500 animate-pulse'}`}></div>
            <span className="text-[10px] font-bold text-zinc-400 uppercase">{status}</span>
          </div>
        </div>
        <div className="flex-1 p-5 overflow-y-auto font-mono text-[11.5px] leading-relaxed flex flex-col gap-3">
          {logs.map((log, idx) => (
            <div key={idx} className="flex items-start gap-3 p-1.5 rounded hover:bg-white/[0.02] transition-colors">
              <span className="text-zinc-600 text-[10px] shrink-0 pt-0.5">{log.timestamp}</span>
              <span className={`px-2 py-0.5 rounded text-[9px] font-bold border shrink-0 uppercase tracking-wider ${getTagColor(log.tag, log.level)}`}>{log.tag}</span>
              <span className={`break-all ${log.level === 'SUCCESS' ? 'text-emerald-400 font-medium' : log.level === 'ERROR' ? 'text-rose-400 font-medium' : 'text-zinc-300'}`}>{log.message}</span>
            </div>
          ))}
          <div ref={terminalEndRef} />
        </div>
      </div>
    </div>
  );
}
export default App;
