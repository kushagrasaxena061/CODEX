cleanup_orphans()

router = APIRouter(prefix="/api", tags=["agent"])

def get_session_workspace(session_id: int) -> str:
    path = os.path.abspath(os.path.join(os.getcwd(), "workspaces", f"session_{session_id}"))
    os.makedirs(path, exist_ok=True)
    return path

class ChatRequest(BaseModel):
    conversation_id: int
    prompt: str

class GithubConnectRequest(BaseModel):
    conversation_id: int
    repo_url: str
    token: str

class ApproveRequest(BaseModel):
    conversation_id: int
    # THE FIX: Made commit_message optional to prevent silent 422 crashes
    commit_message: Optional[str] = None

class RejectRequest(BaseModel):
    conversation_id: int

class RenameRequest(BaseModel):
    title: str

@router.get("/conversations")
def list_conversations(db: Session = Depends(get_db)):
    try:
        convs = db.query(Conversation).order_by(Conversation.created_at.desc()).all()
        if not convs:
            initial = Conversation(title="Default Project")
            db.add(initial)
            db.commit()
            db.refresh(initial)
            ws = get_session_workspace(initial.id)
            current_session_id.set(initial.id)
            GitManager(ws).init_repo()
            convs = [initial]
        return [{"id": c.id, "title": c.title, "github_connected": bool(c.github_repo_url)} for c in convs]
    except Exception as e:
        return []

@router.post("/conversations")
def create_conversation(db: Session = Depends(get_db)):
    count = db.query(Conversation).count()
    new_conv = Conversation(title=f"Project #{count + 1}")
    db.add(new_conv)
    db.commit()
    db.refresh(new_conv)
    ws = get_session_workspace(new_conv.id)
    current_session_id.set(new_conv.id)
    GitManager(ws).init_repo()
    return {"id": new_conv.id, "title": new_conv.title, "github_connected": False}

@router.patch("/conversations/{conv_id}")
def rename_conversation(conv_id: int, req: RenameRequest, db: Session = Depends(get_db)):
    conv = db.query(Conversation).filter(Conversation.id == conv_id).first()
    if not conv: raise HTTPException(status_code=404)
    conv.title = req.title.strip() or "Untitled Project"
    db.commit()
    return {"id": conv.id, "title": conv.title}

@router.delete("/conversations/{conv_id}")
def delete_conversation(conv_id: int, db: Session = Depends(get_db)):
    conv = db.query(Conversation).filter(Conversation.id == conv_id).first()
    if conv:
        db.delete(conv)
        db.commit()
        ws = get_session_workspace(conv_id)
        if os.path.exists(ws): shutil.rmtree(ws, ignore_errors=True)
    return {"status": "deleted"}

@router.get("/conversations/{conv_id}/tasks")
def get_conversation_tasks(conv_id: int, db: Session = Depends(get_db)):
    tasks = db.query(Task).filter(Task.conversation_id == conv_id).order_by(Task.created_at.asc()).all()
    return [{"id": t.id, "prompt": t.prompt, "status": t.status, "summary": t.context_summary} for t in tasks]

@router.get("/telemetry")
async def get_telemetry(conversation_id: int): 
    return {"tokens": token_tracker.get_count(conversation_id)}

@router.get("/logs/live")
async def get_live_logs(conversation_id: int): 
    return {"logs": event_bus.get_logs(conversation_id)}

@router.post("/cancel")
async def cancel_task(req: RejectRequest):
    cancel_manager.request_cancel(req.conversation_id)
    return {"message": "Cancellation requested."}

@router.post("/github/connect")
async def connect_github(req: GithubConnectRequest, db: Session = Depends(get_db)):
    current_session_id.set(req.conversation_id)
    conv = db.query(Conversation).filter(Conversation.id == req.conversation_id).first()
    if not conv: raise HTTPException(status_code=404)
    conv.github_repo_url = req.repo_url.strip()
    conv.github_token = req.token.strip()
    db.commit()
    
    ws = get_session_workspace(req.conversation_id)
    git = GitManager(ws)
    git.init_repo()
    git.set_remote(req.repo_url, req.token)
    return {"status": "success"}

@router.post("/checkpoint/approve")
async def approve_checkpoint(req: ApproveRequest, db: Session = Depends(get_db)):
    current_session_id.set(req.conversation_id)
    conv = db.query(Conversation).filter(Conversation.id == req.conversation_id).first()
    
    # THE FIX: Permanently update Task status in the Database so buttons vanish
    task = db.query(Task).filter(Task.conversation_id == req.conversation_id, Task.status == "PENDING_APPROVAL").order_by(Task.id.desc()).first()
    if task:
        task.status = "COMPLETED"
        db.commit()

    ws = get_session_workspace(req.conversation_id)
    git = GitManager(ws)
    
    final_msg = f"Feature: {req.commit_message}" if req.commit_message else "Human-approved feature update."
    git.create_checkpoint(final_msg)
    
    if conv and conv.github_repo_url and conv.github_token:
        git.set_remote(conv.github_repo_url, conv.github_token)
        git.push()
        event_bus.emit("SYSTEM", f"Approved & pushed to Session #{req.conversation_id} repository.", level="SUCCESS")
    else:
        event_bus.emit("SYSTEM", "Approved and committed locally.", level="SUCCESS")
    return {"status": "approved"}

@router.post("/checkpoint/reject")
async def reject_checkpoint(req: RejectRequest, db: Session = Depends(get_db)):
    current_session_id.set(req.conversation_id)
    
    # THE FIX: Permanently update Task status in the Database so buttons vanish
    task = db.query(Task).filter(Task.conversation_id == req.conversation_id, Task.status == "PENDING_APPROVAL").order_by(Task.id.desc()).first()
    if task:
        task.status = "REJECTED"
        db.commit()

    ws = get_session_workspace(req.conversation_id)
    GitManager(ws).rollback()
    event_bus.emit("SYSTEM", "User rejected changes. Workspace rolled back.", level="ERROR")
    return {"status": "rejected"}

@router.get("/workspace/download")
async def download_workspace(conversation_id: int):
    ws = get_session_workspace(conversation_id)
    zip_path = os.path.join(tempfile.gettempdir(), f"darwin_session_{conversation_id}_export.zip")
    with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
        for root, dirs, files in os.walk(ws):
            if '.git' in root: continue
            for file in files:
                file_path = os.path.join(root, file)
                zipf.write(file_path, os.path.relpath(file_path, ws))
    return FileResponse(path=zip_path, filename=f"darwin_session_{conversation_id}_export.zip", media_type='application/zip')

@router.post("/workspace/upload")
async def upload_workspace(conversation_id: int, file: UploadFile = File(...), db: Session = Depends(get_db)):
    current_session_id.set(conversation_id)
    event_bus.clear()
    ws = get_session_workspace(conversation_id)
    for item in os.listdir(ws):
        if item == ".git": continue
        item_path = os.path.join(ws, item)
        if os.path.isdir(item_path): shutil.rmtree(item_path)
        else: os.remove(item_path)
    zip_path = os.path.join(tempfile.gettempdir(), f"upload_session_{conversation_id}.zip")
    with open(zip_path, "wb") as buffer: shutil.copyfileobj(file.file, buffer)
    with zipfile.ZipFile(zip_path, 'r') as zip_ref: zip_ref.extractall(ws)
    os.remove(zip_path)
    
    git = GitManager(ws)
    git.init_repo()
    conv = db.query(Conversation).filter(Conversation.id == conversation_id).first()
    if conv and conv.github_repo_url and conv.github_token:
        git.set_remote(conv.github_repo_url, conv.github_token)
        
    rag_db.shred_and_embed(ws, conversation_id)
    repo_tree = get_repo_tree(ws)
    if "Empty Directory" not in repo_tree:
        prompt = f"Analyze this repo tree and summarize its architecture in 2 sentences:\n{repo_tree}"
        res = await generate_json(prompt, settings.OLLAMA_MODEL_PLANNING, "Return JSON: {\"architecture_summary\": \"string\"}", max_tokens=200)
        summary = res.get("architecture_summary", "Workspace updated.")
        db.add(Task(conversation_id=conversation_id, prompt="SYSTEM: Codebase Ingestion", status="COMPLETED", context_summary=summary))
        db.commit()
        event_bus.emit("SYSTEM", f"Architecture Mapped: {summary}", level="SUCCESS")
    return {"message": "Workspace uploaded."}

@router.post("/chat")
async def submit_prompt(req: ChatRequest, db: Session = Depends(get_db)):
    current_session_id.set(req.conversation_id)
    event_bus.clear()
    cancel_manager.reset()
    ws = get_session_workspace(req.conversation_id)
    
    recent_tasks = db.query(Task).filter(Task.conversation_id == req.conversation_id).order_by(Task.created_at.asc()).all()[-4:]
    history = "\n".join([f"{t.prompt}\n{t.context_summary or ''}" for t in recent_tasks])
    
    task = Task(conversation_id=req.conversation_id, prompt=req.prompt, status="WORKING")
    db.add(task)
    db.commit()
    db.refresh(task)
    
    try:
        plan = await generate_plan(req.prompt, history, req.conversation_id, ws)
        
        # THE FIX: Injecting session_id directly into Orchestrator for Aggressive Context Re-assertion
        orchestrator = TaskOrchestrator(plan, workspace_root=ws, session_id=req.conversation_id, history=history)
        result = await orchestrator.execute()
        
        current_session_id.set(req.conversation_id)
        
        if result.status == "duplicate":
            GitManager(ws).rollback()
            task.status = "DUPLICATE"
            task.context_summary = result.message
            db.commit()
            return {"status": "duplicate", "message": result.message}
            
        if result.status == "failed":
            GitManager(ws).rollback()
            task.status = "FAILED"
            db.commit()
            return {"status": "failed", "message": "Failed to implement feature after iterative retries."}
            
        task.status = "PENDING_APPROVAL"
        task.context_summary = result.message
        db.commit()
        event_bus.emit("VERIFIED", "Task verified by AI. Awaiting human approval.", level="WARN")
        return {"status": "requires_approval", "message": "Code generated and tested. Please review and approve."}
        
    except InterruptedError:
        current_session_id.set(req.conversation_id)
        GitManager(ws).rollback()
        task.status = "CANCELLED"
        db.commit()
        return {"status": "cancelled", "message": "Task aborted."}
    except Exception as e:
        current_session_id.set(req.conversation_id)
        GitManager(ws).rollback()
        task.status = "ERROR"
        db.commit()
        logger.error(f"Chat Route Critical Error: {str(e)}")
        return {"status": "failed", "message": f"System Crash: {str(e)}"}
