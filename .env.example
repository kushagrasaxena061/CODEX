WORKSPACE_ROOT=./workspaces
DATABASE_URL=sqlite:///./codex.db
LOG_LEVEL=INFO

# Autonomy settings: low, medium, high
AUTONOMY_LEVEL=medium

# Ollama Routing
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_CODING=deepseek-coder:6.7b  # Or your preferred heavy model
OLLAMA_MODEL_PLANNING=llama3:8b          # Or your preferred medium model
OLLAMA_MODEL_FAST=phi3:mini              # For cheap classification tasks
